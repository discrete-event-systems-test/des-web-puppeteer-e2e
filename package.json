{
  "name": "des-web-puppeteer-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:puppeteer",
    "test:puppeteer": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:gateway": "node --test tests/des-gateway.test.mjs",
    "test:first-party": "node --test tests/des-web.test.mjs",
    "test:junit": "node --test --test-concurrency=1 --test-reporter=junit --test-reporter-destination=test-results/junit.xml tests/*.test.mjs",
    "indie:submit": "node scripts/submit-indie.mjs",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "devDependencies": {
    "puppeteer": "25.3.0",
    "yauzl": "3.4.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
